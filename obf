washedhearts.VERSION = "1.0.0"
washedhearts._bit32_polyfill = [=[
local bit32 = bit32 or (function()
    local bit32 = {}
    function bit32.band(a,b) local r=0 local bv=1 while a>0 and b>0 do if a%2==1 and b%2==1 then r=r+bv end a=math.floor(a/2) b=math.floor(b/2) bv=bv*2 end return r end
    function bit32.bor(a,b) local r=0 local bv=1 while a>0 or b>0 do if a%2==1 or b%2==1 then r=r+bv end a=math.floor(a/2) b=math.floor(b/2) bv=bv*2 end return r end
    function bit32.bxor(a,b) local r=0 local bv=1 while a>0 or b>0 do if (a%2==1)~=(b%2==1) then r=r+bv end a=math.floor(a/2) b=math.floor(b/2) bv=bv*2 end return r end
    function bit32.lshift(a,disp) return a*(2^disp) end
    function bit32.rshift(a,disp) return math.floor(a/(2^disp)) end
    return bit32
end)()]=]

function washedhearts._shuffle_table(t, seed)
    math.randomseed(seed)
    local n = #t
    for i = n, 2, -1 do
        local j = math.random(i)
        t[i], t[j] = t[j], t[i]
    end
    return t
end

function washedhearts._gen_opcode_maps(seed)
    local list = {}
    for i=0,37 do list[i+1]=i end
    washedhearts._shuffle_table(list, seed or os.time())
    local c2s, s2c = {}, {}
    for i=1,38 do
        c2s[i] = list[i]
        s2c[list[i]] = i
    end
    return c2s, s2c
end

function washedhearts._enc_string(s, xor_key)
    local b = {}
    for i=1,#s do b[i]=string.byte(s,i)~xor_key end
    return b
end

function washedhearts._enc_number(n, offset)
    return n - offset
end

function washedhearts._pack_instr(a, op_custom, b, c)
    return bit32.band(b,511) + bit32.lshift(bit32.band(a,255),9) + bit32.lshift(bit32.band(op_custom,63),17) + bit32.lshift(bit32.band(c,511),23)
end

function washedhearts._pack_sbx(sbx)
    return sbx + 131071
end

function washedhearts._compile(source)
    local f, e = loadstring(source)
    if not f then error(e) end
    return string.dump(f)
end

function washedhearts._parse_header(bc)
    local pos = 1
    local function rb() local b=string.byte(bc,pos) pos=pos+1 return b end
    local function ri(size) local v=0 for i=0,size-1 do v=v+bit32.lshift(rb(),i*8) end return v end
    local sig = rb()
    if sig~=27 then error("bad signature") end
    local h = {}
    h.lua_version = rb()
    h.format_version = rb()
    h.endianness = rb()
    h.int_size = rb()
    h.size_t_size = rb()
    h.instruction_size = rb()
    h.lua_number_size = rb()
    h.integral_flag = rb()
    return h, pos
end

function washedhearts:_parse_code(proto, pos)
    local function rb() local b=string.byte(self._bc,pos) pos=pos+1 return b end
    local function ri(size) local v=0 for i=0,size-1 do v=v+bit32.lshift(rb(),i*8) end return v end
    local function rs() local l=rb() if l==0 then return""end local s=string.sub(self._bc,pos,pos+l-1) pos=pos+l return s end
    proto.maxstacksize = rb()
    proto.numparams = rb()
    proto.is_vararg = rb()
    proto.num_upvalues = rb()
    proto.code_size = ri(4)
    proto.code = {}
    for i=1,proto.code_size do
        proto.code[i] = ri(4)
    end
    proto.const_size = ri(4)
    proto.constants = {}
    for i=1,proto.const_size do
        local ctype = rb()
        local val
        if ctype==0 then val=nil
        elseif ctype==1 then val=rb()~=0
        elseif ctype==3 then local len=ri(4) val=string.sub(self._bc,pos,pos+len-1) pos=pos+len
        elseif ctype==4 then local len=ri(4) val=string.sub(self._bc,pos,pos+len-1) pos=pos+len
        else error("const type "..ctype) end
        proto.constants[i] = {t=ctype, v=val}
    end
    proto.subproto_size = ri(4)
    proto.subprotos = {}
    for i=1,proto.subproto_size do
        proto.subprotos[i] = {}
        pos = self:_parse_code(proto.subprotos[i], pos)
    end
    proto.lineinfo_size = ri(4)
    if proto.lineinfo_size>0 then
        proto.lineinfo = {}
        for i=1,proto.lineinfo_size do
            proto.lineinfo[i] = ri(4)
        end
    end
    proto.locals_size = ri(4)
    if proto.locals_size>0 then
        proto.locals = {}
        for i=1,proto.locals_size do
            local s = rs()
            proto.locals[i] = {name=s, startpc=ri(4), endpc=ri(4)}
        end
    end
    proto.upvalue_names_size = ri(4)
    if proto.upvalue_names_size>0 then
        proto.upvalue_names = {}
        for i=1,proto.upvalue_names_size do
            proto.upvalue_names[i] = rs()
        end
    end
    return pos
end

function washedhearts:_transform_constants(proto, config)
    local xor_key = config.XOR_KEY or math.random(0,255)
    local num_offset = config.NUM_OFFSET or math.random(10000,50000)
    for _, c in ipairs(proto.constants) do
        if c.t == 3 or c.t == 4 then
            c.v = washedhearts._enc_string(c.v, xor_key)
            c.t = 3
        elseif type(c.v) == "number" then
            c.v = washedhearts._enc_number(c.v, num_offset)
            c.t = 2
        end
    end
    for _, sub in ipairs(proto.subprotos) do
        washedhearts:_transform_constants(sub, config)
    end
    return xor_key, num_offset
end

function washedhearts:_remap_instructions(proto, s2c)
    local new_code = {}
    for i, instr in ipairs(proto.code) do
        local op = bit32.band(instr, 63)
        local a = bit32.band(bit32.rshift(instr, 6), 255)
        local b = bit32.band(bit32.rshift(instr, 23), 511)
        local c = bit32.band(bit32.rshift(instr, 14), 511)
        local custom_op = s2c[op] or op
        if op == 22 or op == 32 then
            local sbx = b * 512 + c - 131071
            local packed_sbx = washedhearts._pack_sbx(sbx)
            b = bit32.band(packed_sbx, 511)
            c = bit32.band(bit32.rshift(packed_sbx, 9), 511)
        end
        new_code[i] = washedhearts._pack_instr(a, custom_op, b, c)
    end
    proto.code = new_code
    for _, sub in ipairs(proto.subprotos) do
        washedhearts:_remap_instructions(sub, s2c)
    end
end

function washedhearts:_proto_to_lua(proto, config, indent)
    indent = indent or ""
    local lines = {}
    local function add(str) table.insert(lines, indent..str) end
    add("{")
    add("p = "..(proto.numparams or 0)..",")
    add("v = "..(proto.is_vararg or 0)..",")
    add("s = "..(proto.maxstacksize or 1)..",")
    add("u = "..(proto.num_upvalues or 0)..",")
    add("i = {")
    for _, instr in ipairs(proto.code) do
        add("  "..instr..",")
    end
    add("},")
    add("k = {")
    for _, c in ipairs(proto.constants) do
        if c.t == 2 then
            add("  {t=2,v="..c.v.."},")
        elseif c.t == 3 then
            local bytes = {}
            for _, b in ipairs(c.v) do bytes[#bytes+1] = b end
            add("  {t=3,v={"..table.concat(bytes,",").."}},")
        else
            add("  {t=0},")
        end
    end
    add("},")
    add("sub = {")
    for _, sub in ipairs(proto.subprotos) do
        local sub_lines = washedhearts:_proto_to_lua(sub, config, indent.."  ")
        for _, l in ipairs(sub_lines) do add(l) end
    end
    add("},")
    add("}")
    return lines
end

